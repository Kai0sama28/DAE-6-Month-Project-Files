*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -s 192.168.56.0/24 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 192.168.56.0/24 -p udp --dport 53 -j ACCEPT
-A INPUT -s 192.168.56.0/24 -p tcp --dport 53 -j ACCEPT
-A INPUT -p icmp --icmp-type echo-request -j ACCEPT
-A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
-A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT
-A INPUT -p tcp --dport 22 -j LOG --log-prefix "IR-INPUT-SSH-DROP: " --log-level 4
-A INPUT -j LOG --log-prefix "IR-INPUT-DROP: " --log-level 4
-A INPUT -j DROP
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -s 192.168.56.0/24 -d 10.20.20.0/24 -p tcp --dport 22 -j ACCEPT
-A FORWARD -s 192.168.56.0/24 -d 10.20.20.0/24 -p tcp --dport 443 -j ACCEPT
-A FORWARD -s 192.168.64.0/24 -d 10.20.20.0/24 -j DROP
-A FORWARD -s 192.168.64.0/24 -d 10.11.1.232 -j DROP
-A FORWARD -j LOG --log-prefix "IR-FORWARD-DROP: " --log-level 4
-A FORWARD -j DROP
COMMIT
