# Wazuh API (real SIEM + alert source)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=admin
WAZUH_API_PASSWORD=change-me
WAZUH_VERIFY_TLS=false

# Wazuh indexer (OpenSearch) — where alerts actually live; Wazuh 4.x has no
# /security-events route, so alert queries go here.
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_INDEXER_INDEX=wazuh-alerts-*

# Evidence API ports
IDENTITY_API_URL=http://localhost:8001
EDR_API_URL=http://localhost:8002

# Database (SQLite default for MVP; swap to Postgres later)
DATABASE_URL=sqlite:///./data/investigations.db

# LLM (weeks 5+)
ANTHROPIC_API_KEY=