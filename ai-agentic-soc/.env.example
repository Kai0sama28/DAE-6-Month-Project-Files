# Wazuh API (real SIEM + alert source)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=admin
WAZUH_API_PASSWORD=change-me
WAZUH_VERIFY_TLS=false

# Wazuh indexer (OpenSearch) — where alerts actually live; Wazuh 4.x has no
# /security-events route, so alert queries go here.
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_INDEXER_INDEX=wazuh-alerts-*

# Evidence API ports
IDENTITY_API_URL=http://localhost:8001
EDR_API_URL=http://localhost:8002

# Database (SQLite default for MVP; swap to Postgres later)
DATABASE_URL=sqlite:///./data/investigations.db

# --- LLM (OpenRouter) ------------------------------------------------------
# The background triage agent reasons with nvidia/nemotron-3.5-lightning:free.
# Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Comma-separated fallbacks tried when the primary model fails or returns
# unparsable JSON. Free-tier routes are flaky, so leave at least one.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TITLE=AI-Agentic SOC Triage Engine

# --- Agent behaviour -------------------------------------------------------
AGENT_POLL_INTERVAL=5           # seconds between indexer polls
AGENT_MIN_LEVEL=4               # minimum rule level collected as context
AGENT_TRIGGER_MIN_LEVEL=10      # minimum rule level allowed to START an investigation
AGENT_SETTLE_SECONDS=25         # grace period for related alerts to land
AGENT_LOOKBACK_MINUTES=30       # how far back the correlation window reaches
AGENT_POST_WINDOW_MINUTES=15    # how far forward the correlation window reaches
AGENT_DEDUPE_WINDOW_MINUTES=2  # suppress repeat reports for the same incident
AGENT_BURST_GAP_SECONDS=120     # silence gap that separates two attack bursts
AGENT_MAX_CORRELATED_ALERTS=800
AGENT_MAX_EVENTS_IN_PROMPT=60
AGENT_MANUAL_BASELINE_MINUTES=45  # analyst baseline used for the time-saved metric
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_MAX_TOKENS=8000
AGENT_LLM_TIMEOUT=150
AGENT_LLM_MAX_RETRIES=1
AGENT_LLM_BUDGET=600
AGENT_USE_LLM=true
AGENT_NOTIFY=true               # macOS desktop notification on completion
AGENT_NOTIFY_SOUND=true
AGENT_NOTIFY_OPEN_REPORT=true   # clickable dialog that opens the report
AGENT_NOTIFY_TITLE=AI-Agentic SOC
AGENT_REPORTS_DIR=./reports
AGENT_STATE_FILE=./data/agent_state.json
AGENT_USE_IDENTITY_API=true
AGENT_USE_EDR_API=true

# --- Weeks 5+ (agent orchestration, alternative LLM provider) --------------
# anthropic>=0.123
ANTHROPIC_API_KEY=
